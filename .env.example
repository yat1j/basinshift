# =============================================================================
# BASINSHIFT Platform Configuration Environment Template
# Copy this file to .env (or frontend/.env.local) and adjust values as needed.
# NEVER commit actual secrets, API tokens, or production credentials.
# =============================================================================

# Platform Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Frontend Configuration
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Model Inference Backend Integration
# When Member 1's FastAPI inference service is active, point this to its URL.
# If offline, the frontend automatically falls back to Verified Benchmark Replay mode.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Service Configuration (FastAPI)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_WORKERS=1

# Model Artifact Directory Reference
# Points to local directory where Variant A model artifacts (.joblib) are stored.
MODEL_ARTIFACTS_DIR=artifacts/variant_a
